#!/usr/bin/env bash
# Version: 2026071201
set -euo pipefail

# install repo/bootstrap RPMs if their package is missing
{{- range .packages.linux.fedora.repos.rpms }}
if ! rpm -q {{ .package | quote }} >/dev/null 2>&1; then
  sudo dnf install -y{{ if get . "nogpgcheck" }} --nogpgcheck{{ end }}{{ with get . "repofrompath" }} --repofrompath {{ . | quote }}{{ end }}{{ with get . "packages" }}{{ range . }} {{ . | quote }}{{ end }}{{ else }} {{ .url }}{{ end }}
fi
{{- end }}

# add repos from repofiles if the target .repo file is absent
{{- range .packages.linux.fedora.repos.addrepo }}
if [ ! -f {{ .path | quote }} ]; then
  sudo dnf config-manager addrepo --from-repofile={{ .repofile }}
fi
{{- end }}

# write .repo files if absent
{{- range .packages.linux.fedora.repos.files }}
if [ ! -f {{ .path | quote }} ]; then
  {{- $keyImport := get . "key_import" }}
  {{- if $keyImport }}
    sudo rpm --import {{ $keyImport | quote }}
  {{- end }}
  sudo tee {{ .path | quote }} >/dev/null <<'EOF'
{{ .content }}
EOF
fi
{{- end }}

# Apply preferences only after bootstrap and managed repository files exist.
{{- if .packages.linux.fedora.repos.setopt }}
sudo dnf config-manager setopt \
{{- range .packages.linux.fedora.repos.setopt }}
  {{ . | quote }} \
{{- end }}
;
{{- end }}

groups=(
  {{ range .packages.linux.fedora.dnf_groups -}}
  {{ . }}
  {{ end -}}
)

if ((${#groups[@]})); then
  sudo dnf group install -y "${groups[@]}"
fi

packages=(
  {{ range .packages.linux.fedora.dnf_packages -}}
  {{ . }}
  {{ end -}}
)

if ((${#packages[@]})); then
  sudo dnf install -y "${packages[@]}"
fi

apps=(
  {{ range .packages.linux.fedora.flatpak -}}
  {{ . }}
  {{ end -}}
)

if ((${#apps[@]})); then
  flatpak install flathub "${apps[@]}"
fi
