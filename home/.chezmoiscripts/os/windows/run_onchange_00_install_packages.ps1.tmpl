#Requires -Version 5.1
$ErrorActionPreference = 'Stop'

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning 'winget is not available; skipping Windows package installation.'
    exit 0
}

$packages = @(
{{- range .packages.windows.winget }}
    {{ . | squote }}
{{- end }}
)

foreach ($id in $packages) {
    winget list --id $id --exact --accept-source-agreements 2>&1 | Out-Null
    if ($LASTEXITCODE -eq 0) {
        continue
    }

    Write-Host "Installing $id via winget..."
    winget install --id $id --exact --silent --accept-package-agreements --accept-source-agreements
    # -1978335189 (0x8A15002B): already installed / no applicable update found.
    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne -1978335189) {
        throw "winget install failed for $id with exit code $LASTEXITCODE"
    }
}
