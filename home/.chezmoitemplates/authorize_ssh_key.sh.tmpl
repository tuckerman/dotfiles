#!/usr/bin/env bash
set -euo pipefail

KEY={{ include "private_dot_ssh/id_ed25519_1password.pub" | trim | quote }}

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"

if ! awk -v key="$KEY" '$1 " " $2 == key { found = 1 } END { exit !found }' "$HOME/.ssh/authorized_keys"; then
  printf '%s\n' "$KEY" >> "$HOME/.ssh/authorized_keys"
fi
