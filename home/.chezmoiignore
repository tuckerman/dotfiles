{{ if ne .profile "personal" -}}
.chezmoiscripts/profile/personal/**
.ssh/config.d/personal
.ssh/config.d/tailnet
.ssh/config.d/bookmarks
{{ end -}}

{{ if ne .profile "g" -}}
.chezmoiscripts/profile/g/**
.ssh/config.d/g
{{ end -}}

{{ if ne .profile "otto" -}}
.chezmoiscripts/profile/otto/**
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/os/darwin/**
.config/karabiner/**
{{ end -}}

{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/os/linux/**
.local/share/applications/**
.local/share/steamhome
.config/pipewire/**
.config/user-dirs.dirs
.rpmmacros
{{ else -}}
{{ if eq .profile "g" -}}
.local/share/applications/google-chrome.desktop
{{ end -}}

{{- $osID := get .chezmoi.osRelease "id" | default "" -}}
{{- $osVariantID := get .chezmoi.osRelease "variantID" | default "" -}}

{{ if ne $osID "debian" -}}
.chezmoiscripts/os/linux/debian/**
{{ end -}}

{{ if ne $osID "fedora" -}}
.chezmoiscripts/os/linux/fedora/**
.rpmmacros
{{ end -}}

{{ if ne $osID "rocky" -}}
.chezmoiscripts/os/linux/rocky/**
{{ end -}}

{{ if ne $osVariantID "kde" -}}
.chezmoiscripts/os/linux/kde/**
{{ end -}}
{{ end -}}

{{ if ne .chezmoi.os "windows" -}}
.chezmoiscripts/os/windows/**
Documents/PowerShell/**
AppData/**
{{ else -}}
.chezmoiscripts/**/*.sh
.zshenv
.hushlogin
.config/zsh/**
.config/tmux/**
.config/shpool/**
.config/ghostty/**
.config/1Password/**
.local/bin/**
.ssh/config.d/onepassword
{{ end -}}

{{ if ne .chezmoi.hostname "thanatos" -}}
.chezmoiscripts/host/thanatos/**
{{ end -}}

{{ if not .enable_onepassword -}}
.ssh/config.d/onepassword
.config/1Password/**
AppData/Local/1Password/**
.config/zsh/env.d/onepassword.zsh
.config/git/signing.gitconfig
{{ end -}}
