{{ if ne .profile "personal" -}}
.chezmoiscripts/profile/personal/**

.ssh/config.d/personal
.ssh/config.d/tailnet
{{ end -}}

{{ if ne .profile "otto" -}}
.chezmoiscripts/profile/otto/**
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/os/darwin/**
{{ end -}}

{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/os/linux/**

.local/share/applications/google-chrome.desktop
{{ end -}}

{{ if ne .chezmoi.osRelease.id "debian" -}}
.chezmoiscripts/os/linux/debian/**
{{ end -}}

{{ if ne .chezmoi.osRelease.id "fedora" -}}
.chezmoiscripts/os/linux/fedora/**
.rpmmacros
{{ end -}}

{{ if ne .chezmoi.osRelease.id "rocky" -}}
.chezmoiscripts/os/linux/rocky/**
{{ end -}}

{{- if or (not (hasKey .chezmoi.osRelease "variant")) (ne (index .chezmoi.osRelease "variant") "kde") -}}
.chezmoiscripts/os/linux/kde/**
{{ end -}}

{{ if eq .chezmoi.os "windows" -}}
.chezmoiscripts/**/*.sh
{{- end }}

{{- if ne .chezmoi.hostname "thanatos" }}
.chezmoiscripts/host/thanatos/**
{{ end -}}

{{ if not .enable_onepassword -}}
.ssh/config.d/1password
.config/1Password/**
.config/git/signing.gitconfig
{{- end }}
